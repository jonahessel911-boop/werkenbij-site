{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/vacatures.html", "destination": "/vacatures", "permanent": true },
    { "source": "/over-ons.html", "destination": "/over-ons", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/sales-vacature.html", "destination": "/sales-vacature", "permanent": true },
    { "source": "/appointment-vacature.html", "destination": "/appointment-vacature", "permanent": true },
    { "source": "/producten", "destination": "https://www.batterijconcept.nl/producten", "permanent": true },
    { "source": "/producten.html", "destination": "https://www.batterijconcept.nl/producten", "permanent": true },
    { "source": "/advies-aan-huis", "destination": "https://www.batterijconcept.nl/advies-aan-huis", "permanent": true },
    { "source": "/advies-aan-huis.html", "destination": "https://www.batterijconcept.nl/advies-aan-huis", "permanent": true },
    { "source": "/service", "destination": "https://www.batterijconcept.nl/service", "permanent": true },
    { "source": "/service.html", "destination": "https://www.batterijconcept.nl/service", "permanent": true },
    { "source": "/vrienden-van-vrienden", "destination": "https://www.batterijconcept.nl/vrienden-van-vrienden", "permanent": true },
    { "source": "/vrienden-van-vrienden.html", "destination": "https://www.batterijconcept.nl/vrienden-van-vrienden", "permanent": true },
    { "source": "/algemene-voorwaarden", "destination": "https://www.batterijconcept.nl/algemene-voorwaarden", "permanent": true },
    { "source": "/algemene-voorwaarden.html", "destination": "https://www.batterijconcept.nl/algemene-voorwaarden", "permanent": true }
  ]
}
